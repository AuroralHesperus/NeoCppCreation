{
  "name": "neo-cpp-creation",
  "displayName": "Neo C++ Creation",
  "description": "Quickly create a C++ source file with a basic template.",
  "version": "1.0.2",
  "publisher": "AuroralHesperus",
  "license": "MIT",
  "keywords": [
    "C++",
    "cpp",
    "new file",
    "template"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "newcpp",
        "title": "newcpp"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.0"
  }
}
