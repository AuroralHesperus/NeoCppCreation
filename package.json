{
  "name": "neo-cpp-creation",
  "displayName": "Neo C++ Creation",
  "description": "快速创建带基础模板的 C++ 源文件。",
  "version": "0.1.1",
  "publisher": "AuroralHesperus",
  "license": "MIT",
  "keywords": [
    "C++",
    "cpp",
    "new file",
    "template"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "neoCppCreation.createFile",
        "title": "快速新建 C++ 文件"
      },
      {
        "command": "neoCppCreation.newFileAlias",
        "title": "newcpp"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
