{
  "name": "neo-cpp-creation",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "1.0.0",
  "publisher": "AuroralHesperus",
  "license": "MIT",
  "keywords": [
    "C++",
    "cpp",
    "new file",
    "template"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "neoCppCreation.language": {
          "type": "string",
          "enum": [
            "en",
            "zh-CN",
            "zh-TW",
            "ru",
            "es",
            "fr"
          ],
          "enumTitles": [
            "%language.english%",
            "%language.simplifiedChinese%",
            "%language.traditionalChinese%",
            "%language.russian%",
            "%language.spanish%",
            "%language.french%"
          ],
          "default": "zh-CN",
          "description": "%configuration.language.description%"
        },
        "neoCppCreation.commandName": {
          "type": "string",
          "default": "newcpp",
          "description": "%configuration.commandName.description%"
        }
      }
    },
    "commands": [
      {
        "command": "neoCppCreation.createFile",
        "title": "%command.createFile.title%"
      },
      {
        "command": "neoCppCreation.newFileAlias",
        "title": "newcpp",
        "enablement": "config.neoCppCreation.commandName != ''"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
